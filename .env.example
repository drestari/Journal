# AJSMR Application Environment Configuration
# Copy this file to .env for local environment overrides

# Main Journal Database Configuration
MAIN_DB_HOST=127.0.0.1
MAIN_DB_NAME=ajsmrjournal
MAIN_DB_USER=root
MAIN_DB_PASS=

# Editorial Subsystem Database Configuration
EDITORIAL_DB_HOST=127.0.0.1
EDITORIAL_DB_NAME=ajsmr_editorial
EDITORIAL_DB_USER=root
EDITORIAL_DB_PASS=

# Mail Transport Configuration (SMTP)
MAIL_ENABLED=true
MAIL_HOST=smtp.ajsmrjournal.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@ajsmrjournal.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@ajsmrjournal.com
MAIL_FROM_NAME=AJSMR Editorial Team
